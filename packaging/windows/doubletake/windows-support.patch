diff --git a/internal/airplay/proc_windows.go b/internal/airplay/proc_windows.go
new file mode 100644
index 0000000..8fede69
--- /dev/null
+++ b/internal/airplay/proc_windows.go
@@ -0,0 +1,69 @@
+//go:build windows
+
+package airplay
+
+import (
+	"log"
+	"os/exec"
+	"sync"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// prepareChildProcess keeps GStreamer's console tools from opening a console
+// window when doubletake itself runs without one (started by a GUI app).
+func prepareChildProcess(cmd *exec.Cmd) {
+	if cmd.SysProcAttr == nil {
+		cmd.SysProcAttr = &syscall.SysProcAttr{}
+	}
+	cmd.SysProcAttr.HideWindow = true
+	cmd.SysProcAttr.CreationFlags |= windows.CREATE_NO_WINDOW
+}
+
+func bindChildLifetime(*exec.Cmd) {}
+
+var (
+	childJobOnce sync.Once
+	childJob     windows.Handle
+)
+
+// killOnCloseJob is a job object whose handle only doubletake holds. Windows
+// closes it when doubletake exits for any reason, which terminates every
+// capture child assigned to it: the counterpart of Linux's Pdeathsig.
+func killOnCloseJob() windows.Handle {
+	childJobOnce.Do(func() {
+		job, err := windows.CreateJobObject(nil, nil)
+		if err != nil {
+			log.Printf("[CAPTURE] warning: create job object: %v", err)
+			return
+		}
+		info := windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION{}
+		info.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+		if _, err := windows.SetInformationJobObject(job, windows.JobObjectExtendedLimitInformation,
+			uintptr(unsafe.Pointer(&info)), uint32(unsafe.Sizeof(info))); err != nil {
+			log.Printf("[CAPTURE] warning: configure job object: %v", err)
+			_ = windows.CloseHandle(job)
+			return
+		}
+		childJob = job
+	})
+	return childJob
+}
+
+func afterChildStart(cmd *exec.Cmd) {
+	job := killOnCloseJob()
+	if job == 0 || cmd.Process == nil {
+		return
+	}
+	process, err := windows.OpenProcess(windows.PROCESS_SET_QUOTA|windows.PROCESS_TERMINATE, false, uint32(cmd.Process.Pid))
+	if err != nil {
+		log.Printf("[CAPTURE] warning: open child process: %v", err)
+		return
+	}
+	defer windows.CloseHandle(process)
+	if err := windows.AssignProcessToJobObject(job, process); err != nil {
+		log.Printf("[CAPTURE] warning: assign child to job object: %v", err)
+	}
+}
diff --git a/internal/daemon/control.go b/internal/daemon/control.go
new file mode 100644
index 0000000..5723acb
--- /dev/null
+++ b/internal/daemon/control.go
@@ -0,0 +1,122 @@
+package daemon
+
+import (
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+// A control endpoint is either a Unix socket path or "tcp:HOST:PORT" on a
+// loopback address. TCP exists for clients without AF_UNIX (Python on
+// Windows). Anyone on the machine can reach a loopback port, so a TCP daemon
+// writes its address and a random token to an owner-only control file and
+// rejects requests without that token.
+const tcpControlPrefix = "tcp:"
+
+// ControlInfo is the content of the control file of a TCP daemon.
+type ControlInfo struct {
+	Addr  string `json:"addr"`
+	Token string `json:"token"`
+	PID   int    `json:"pid"`
+}
+
+// IsTCPControl reports whether a -socket value names a TCP endpoint.
+func IsTCPControl(socket string) bool {
+	return strings.HasPrefix(socket, tcpControlPrefix)
+}
+
+// DefaultSocketPath returns the default control endpoint: a Unix socket in
+// XDG_RUNTIME_DIR, or an ephemeral loopback TCP port on Windows.
+func DefaultSocketPath() string {
+	if runtime.GOOS == "windows" {
+		return tcpControlPrefix + "127.0.0.1:0"
+	}
+	dir := os.Getenv("XDG_RUNTIME_DIR")
+	if dir == "" {
+		dir = "/tmp"
+	}
+	return filepath.Join(dir, "doubletake.sock")
+}
+
+// DefaultControlFile is where a TCP daemon publishes its address and token:
+// %LOCALAPPDATA%\doubletake\control.json on Windows (a per-user directory),
+// next to the default socket elsewhere.
+func DefaultControlFile() string {
+	if runtime.GOOS == "windows" {
+		if dir, err := os.UserCacheDir(); err == nil {
+			return filepath.Join(dir, "doubletake", "control.json")
+		}
+	}
+	return filepath.Join(filepath.Dir(DefaultSocketPath()), "doubletake-control.json")
+}
+
+func listenControl(socket string) (net.Listener, error) {
+	if !IsTCPControl(socket) {
+		return net.Listen("unix", socket)
+	}
+	addr := strings.TrimPrefix(socket, tcpControlPrefix)
+	host, _, err := net.SplitHostPort(addr)
+	if err != nil {
+		return nil, fmt.Errorf("control address %q: %w", addr, err)
+	}
+	if ip := net.ParseIP(host); host != "localhost" && (ip == nil || !ip.IsLoopback()) {
+		return nil, fmt.Errorf("control address %q is not a loopback address", addr)
+	}
+	return net.Listen("tcp", addr)
+}
+
+func newControlToken() (string, error) {
+	buf := make([]byte, 32)
+	if _, err := rand.Read(buf); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(buf), nil
+}
+
+// writeControlFile replaces the control file atomically so a client never
+// reads a half-written token.
+func writeControlFile(path string, info ControlInfo) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return err
+	}
+	data, err := json.Marshal(info)
+	if err != nil {
+		return err
+	}
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, data, 0600); err != nil {
+		return err
+	}
+	if err := os.Rename(tmp, path); err != nil {
+		_ = os.Remove(tmp)
+		return err
+	}
+	return nil
+}
+
+// ReadControlFile returns the address and token of a running TCP daemon.
+func ReadControlFile(path string) (ControlInfo, error) {
+	var info ControlInfo
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return info, err
+	}
+	if err := json.Unmarshal(data, &info); err != nil {
+		return info, fmt.Errorf("control file %s: %w", path, err)
+	}
+	if info.Addr == "" || info.Token == "" {
+		return info, fmt.Errorf("control file %s is incomplete", path)
+	}
+	return info, nil
+}
+
+func tokenMatches(want, got string) bool {
+	return subtle.ConstantTimeCompare([]byte(want), []byte(got)) == 1
+}
diff --git a/internal/daemon/control_test.go b/internal/daemon/control_test.go
new file mode 100644
index 0000000..e3cf769
--- /dev/null
+++ b/internal/daemon/control_test.go
@@ -0,0 +1,122 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// startTCPDaemon runs a daemon on an ephemeral loopback port and returns the
+// control information it published.
+func startTCPDaemon(t *testing.T) (ControlInfo, string) {
+	t.Helper()
+	controlFile := filepath.Join(t.TempDir(), "control.json")
+	d, err := New(Config{
+		SocketPath:  "tcp:127.0.0.1:0",
+		ControlFile: controlFile,
+		CredBackend: "file",
+		CredFile:    filepath.Join(t.TempDir(), "credentials.json"),
+		TestMode:    true,
+		NoAudio:     true,
+	})
+	if err != nil {
+		t.Fatalf("create daemon: %v", err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- d.Run(ctx) }()
+	t.Cleanup(func() {
+		cancel()
+		d.Shutdown()
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Errorf("daemon stopped with error: %v", err)
+			}
+		case <-time.After(5 * time.Second):
+			t.Error("daemon did not stop")
+		}
+		if _, err := os.Stat(controlFile); !os.IsNotExist(err) {
+			t.Errorf("control file left behind after shutdown: %v", err)
+		}
+	})
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		info, err := ReadControlFile(controlFile)
+		if err == nil {
+			return info, controlFile
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("control file not published: %v", err)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func tcpRequest(t *testing.T, addr string, req Request) Response {
+	t.Helper()
+	conn, err := net.DialTimeout("tcp", addr, 2*time.Second)
+	if err != nil {
+		t.Fatalf("dial %s: %v", addr, err)
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	if err := json.NewEncoder(conn).Encode(req); err != nil {
+		t.Fatalf("send request: %v", err)
+	}
+	var resp Response
+	if err := json.NewDecoder(conn).Decode(&resp); err != nil {
+		t.Fatalf("read response: %v", err)
+	}
+	return resp
+}
+
+func TestTCPControlRequiresPublishedToken(t *testing.T) {
+	info, controlFile := startTCPDaemon(t)
+
+	if host, _, _ := net.SplitHostPort(info.Addr); host != "127.0.0.1" {
+		t.Fatalf("control address %q is not on loopback", info.Addr)
+	}
+	if info.PID != os.Getpid() || len(info.Token) != 64 {
+		t.Fatalf("control info = %+v", info)
+	}
+	if stat, err := os.Stat(controlFile); err != nil {
+		t.Fatalf("stat control file: %v", err)
+	} else if mode := stat.Mode().Perm(); filepath.Separator == '/' && mode != 0600 {
+		t.Fatalf("control file mode = %o, want 600", mode)
+	}
+
+	for _, token := range []string{"", "wrong", info.Token[:63]} {
+		resp := tcpRequest(t, info.Addr, Request{Cmd: "status", Token: token})
+		if resp.OK || resp.Error != "unauthorized" {
+			t.Fatalf("token %q: response = %+v, want unauthorized", token, resp)
+		}
+	}
+	resp := tcpRequest(t, info.Addr, Request{Cmd: "status", Token: info.Token})
+	if !resp.OK {
+		t.Fatalf("status with token = %+v", resp)
+	}
+}
+
+func TestTCPControlRejectsSecondDaemon(t *testing.T) {
+	_, controlFile := startTCPDaemon(t)
+	second := &Daemon{cfg: Config{SocketPath: "tcp:127.0.0.1:0", ControlFile: controlFile}}
+	err := second.Run(context.Background())
+	if err == nil || !strings.Contains(err.Error(), "already running") {
+		t.Fatalf("second daemon error = %v, want already-running error", err)
+	}
+}
+
+func TestListenControlRejectsNonLoopbackTCP(t *testing.T) {
+	for _, socket := range []string{"tcp:0.0.0.0:0", "tcp:192.0.2.1:0", "tcp:[::]:0", "tcp:noport"} {
+		if ln, err := listenControl(socket); err == nil {
+			ln.Close()
+			t.Errorf("listenControl(%q) succeeded", socket)
+		}
+	}
+}
