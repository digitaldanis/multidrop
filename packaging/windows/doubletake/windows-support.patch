diff --git a/internal/airplay/capture_d3d11.go b/internal/airplay/capture_d3d11.go
new file mode 100644
index 0000000..13e881f
--- /dev/null
+++ b/internal/airplay/capture_d3d11.go
@@ -0,0 +1,100 @@
+package airplay
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// Windows screen capture uses GStreamer's d3d11 plugin: DXGI desktop
+// duplication of the primary monitor, colour conversion and scaling on the
+// GPU, then one download into system memory for the shared encoding path.
+
+var windowsCaptureElements = []string{"d3d11screencapturesrc", "d3d11convert", "d3d11download"}
+
+func checkWindowsCaptureElements(hasElement func(string) bool) error {
+	var missing []string
+	for _, element := range windowsCaptureElements {
+		if !hasElement(element) {
+			missing = append(missing, element)
+		}
+	}
+	if len(missing) > 0 {
+		return fmt.Errorf("GStreamer %s not found; Windows screen capture needs GStreamer 1.22 or newer with the d3d11 plugin",
+			strings.Join(missing, ", "))
+	}
+	return nil
+}
+
+// d3d11CaptureStages returns the capture source and the stages before the
+// shared videoconvert. The GPU already produces the encoder's input size and,
+// for NV12 encoders, its format, so the shared conversion and scaling stages
+// pass buffers through unchanged.
+func d3d11CaptureStages(cfg CaptureConfig, encoder encoderResult, fps int) (gstStage, []gstStage) {
+	source := gstStage{
+		"d3d11screencapturesrc",
+		fmt.Sprintf("show-cursor=%t", cfg.ShowCursor),
+	}
+	// Any GPU-side format the encoder cannot take directly stays BGRA, which
+	// every DXGI capture produces, and videoconvert finishes the job.
+	format := "BGRA"
+	if encoder.rawFormat == "NV12" {
+		format = "NV12"
+	}
+	scaled := fmt.Sprintf("video/x-raw(memory:D3D11Memory),format=%s", format)
+	if width, height := cfg.MaxWidth&^1, cfg.MaxHeight&^1; width > 0 && height > 0 {
+		scaled += fmt.Sprintf(",width=%d,height=%d,pixel-aspect-ratio=1/1", width, height)
+	}
+	return source, []gstStage{
+		{fmt.Sprintf("video/x-raw(memory:D3D11Memory),framerate=%d/1", fps)},
+		{"d3d11convert", "add-borders=true"},
+		{scaled},
+		{"d3d11download"},
+		lowLatencyVideoQueueStage(),
+	}
+}
+
+func startPreparedWindowsCapture(startupCtx, lifetimeCtx context.Context, cfg CaptureConfig, encoder encoderResult, timestampedOutput bool) (*ScreenCapture, error) {
+	startupCtx, cancelStartup := context.WithTimeout(normalizeContext(startupCtx), captureStartupBudget)
+	defer cancelStartup()
+	captureCtx, cancel := context.WithCancel(normalizeContext(lifetimeCtx))
+
+	fps := cfg.FPS
+	if fps <= 0 {
+		fps = 30
+	}
+	source, beforeConvert := d3d11CaptureStages(cfg, encoder, fps)
+	gstArgs := buildGstVideoPipeline(source, beforeConvert, nil, encoder, cfg.MaxWidth, cfg.MaxHeight, timestampedOutput)
+
+	dbg("[CAPTURE] gst-launch-1.0 (d3d11) %s", strings.Join(gstArgs, " "))
+	return launchGstVideoCapture(startupCtx, captureCtx, cancel, gstArgs, encoder, fps, timestampedOutput,
+		"Windows desktop capture")
+}
+
+// Hardware encoder elements register whenever their plugin loads, even on
+// machines whose GPU or driver cannot open a session, so on Windows they are
+// checked with a few frames before being offered (hasGstElement).
+var windowsHardwareEncoders = map[string]bool{
+	"vulkanh264enc": true, "nvh264enc": true, "nvh265enc": true,
+	"qsvh264enc": true, "amfh264enc": true, "mfh264enc": true,
+}
+
+func windowsEncoderProbeArgs(element string) []string {
+	args := []string{"--quiet", "videotestsrc", "num-buffers=3",
+		"!", "video/x-raw,format=NV12,width=640,height=360,framerate=30/1"}
+	if element == "vulkanh264enc" {
+		args = append(args, "!", "vulkanupload")
+	}
+	return append(args, "!", element, "!", "fakesink")
+}
+
+func windowsEncoderWorks(element string) bool {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	err := gstCommand(ctx, "gst-launch-1.0", windowsEncoderProbeArgs(element)...).Run()
+	if err != nil {
+		dbg("[CAPTURE] %s is registered but cannot encode here: %v", element, err)
+	}
+	return err == nil
+}
