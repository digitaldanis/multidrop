diff --git a/internal/airplay/gst_tools.go b/internal/airplay/gst_tools.go
new file mode 100644
index 0000000..020a9d8
--- /dev/null
+++ b/internal/airplay/gst_tools.go
@@ -0,0 +1,72 @@
+package airplay
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"sync"
+)
+
+// gstToolPath resolves a GStreamer command-line tool. Linux packages put it on
+// PATH. On Windows the official MSVC installer does not, and applications
+// commonly ship a private GStreamer next to doubletake, so a few well-known
+// roots are tried first.
+func gstToolPath(name string) string {
+	if runtime.GOOS != "windows" {
+		return name
+	}
+	exe := name + ".exe"
+	for _, root := range gstWindowsRoots() {
+		candidate := filepath.Join(root, "bin", exe)
+		if info, err := os.Stat(candidate); err == nil && !info.IsDir() {
+			return candidate
+		}
+	}
+	return name
+}
+
+// gstWindowsRoots lists GStreamer installation roots in priority order:
+// an explicit override, a private copy shipped beside the executable, then
+// the system-wide MSVC installation.
+func gstWindowsRoots() []string {
+	var roots []string
+	if root := os.Getenv("DOUBLETAKE_GSTREAMER_ROOT"); root != "" {
+		roots = append(roots, root)
+	}
+	if exe, err := os.Executable(); err == nil {
+		roots = append(roots, filepath.Join(filepath.Dir(exe), "gstreamer"))
+	}
+	for _, env := range []string{"GSTREAMER_1_0_ROOT_MSVC_X86_64", "GSTREAMER_1_0_ROOT_X86_64"} {
+		if root := os.Getenv(env); root != "" {
+			roots = append(roots, root)
+		}
+	}
+	return roots
+}
+
+// gstCommand builds a GStreamer tool invocation with the platform's child
+// process attributes (no console window on Windows).
+func gstCommand(ctx context.Context, name string, args ...string) *exec.Cmd {
+	cmd := exec.CommandContext(normalizeContext(ctx), gstToolPath(name), args...)
+	prepareChildProcess(cmd)
+	return cmd
+}
+
+// gstElementCache remembers gst-inspect results. Inspecting one element
+// loads the plugin registry each time, which takes around a second on
+// Windows, and capture setup probes many elements.
+var gstElementCache sync.Map
+
+func hasGstElement(name string) bool {
+	if known, ok := gstElementCache.Load(name); ok {
+		return known.(bool)
+	}
+	present := gstCommand(context.Background(), "gst-inspect-1.0", name).Run() == nil
+	if present && runtime.GOOS == "windows" && windowsHardwareEncoders[name] {
+		present = windowsEncoderWorks(name)
+	}
+	gstElementCache.Store(name, present)
+	return present
+}
