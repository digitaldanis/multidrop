+package daemonclient
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"doubletake/internal/daemon"
+)
+
+func TestClientUsesControlFileForTCP(t *testing.T) {
+	controlFile := filepath.Join(t.TempDir(), "control.json")
+	d, err := daemon.New(daemon.Config{
+		SocketPath:  "tcp:127.0.0.1:0",
+		ControlFile: controlFile,
+		CredBackend: "file",
+		CredFile:    filepath.Join(t.TempDir(), "credentials.json"),
+		TestMode:    true,
+		NoAudio:     true,
+	})
+	if err != nil {
+		t.Fatalf("create daemon: %v", err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- d.Run(ctx) }()
+	defer func() {
+		cancel()
+		d.Shutdown()
+		<-done
+	}()
+
+	client := &Client{SocketPath: "tcp:127.0.0.1:0", ControlFile: controlFile}
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		resp, err := client.Status()
+		if err == nil {
+			if !resp.OK {
+				t.Fatalf("status = %+v", resp)
+			}
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("status: %v", err)
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+}
diff --git a/internal/daemon/lock_unix.go b/internal/daemon/lock_unix.go
new file mode 100644
index 0000000..a805b17
--- /dev/null
+++ b/internal/daemon/lock_unix.go
@@ -0,0 +1,27 @@
+//go:build !windows
+
+package daemon
+
+import (
+	"errors"
+	"os"
+	"syscall"
+)
+
+var errLockHeld = errors.New("lock held by another process")
+
+func lockExclusive(f *os.File) error {
+	err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+	if errors.Is(err, syscall.EWOULDBLOCK) || errors.Is(err, syscall.EAGAIN) {
+		return errLockHeld
+	}
+	return err
+}
+
+func unlock(f *os.File) {
+	_ = syscall.Flock(int(f.Fd()), syscall.LOCK_UN)
+}
+
+func isConnRefused(err error) bool {
+	return errors.Is(err, syscall.ECONNREFUSED)
+}
diff --git a/internal/daemon/lock_windows.go b/internal/daemon/lock_windows.go
new file mode 100644
index 0000000..af635bf
--- /dev/null
+++ b/internal/daemon/lock_windows.go
@@ -0,0 +1,34 @@
+//go:build windows
+
+package daemon
+
+import (
+	"errors"
+	"os"
+	"syscall"
+
+	"golang.org/x/sys/windows"
+)
+
+var errLockHeld = errors.New("lock held by another process")
+
+func lockExclusive(f *os.File) error {
+	var overlapped windows.Overlapped
+	err := windows.LockFileEx(windows.Handle(f.Fd()),
+		windows.LOCKFILE_EXCLUSIVE_LOCK|windows.LOCKFILE_FAIL_IMMEDIATELY, 0, 1, 0, &overlapped)
+	if errors.Is(err, windows.ERROR_LOCK_VIOLATION) {
+		return errLockHeld
+	}
+	return err
+}
+
+func unlock(f *os.File) {
+	var overlapped windows.Overlapped
+	_ = windows.UnlockFileEx(windows.Handle(f.Fd()), 0, 1, 0, &overlapped)
+}
+
+// isConnRefused also matches Winsock's own code: Go's syscall.ECONNREFUSED
+// is a synthetic value on Windows that a failed AF_UNIX dial never returns.
+func isConnRefused(err error) bool {
+	return errors.Is(err, windows.WSAECONNREFUSED) || errors.Is(err, syscall.ECONNREFUSED)
+}
